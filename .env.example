PLATFORM_VERSION=1.0.0
IMAGE_ARCH=arm64
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8088
WEB_PORT_CONFLICT_POLICY=next
DATA_ROOT=/TRS/lxAI
DOCKER_AUTO_INSTALL=true
DOCKER_DATA_ROOT=/TRS/lxAI/docker-engine
HOST_TOOLS_INSTALL_DIR=/usr/local/bin
MODEL_BASE_URL=http://host.docker.internal:6215/v1
MODEL_NAME=TT3.6-27B-0623
MODEL_API_KEY=
MODEL_AUTO_DETECT=false
MODEL_RUNTIME_MANAGED=false
AGENT_MAX_STEPS=10
TOOL_TIMEOUT=120
SAFE_MODE=true
ALLOW_DANGEROUS_TOOLS=false
DB_WRITE_ENABLED=false
HTTP_ALLOW_PRIVATE_ONLY=true
AGENT_CPUS=2.0
AGENT_MEMORY=4g
AGENT_PIDS_LIMIT=256
TOOL_CPUS=2.0
TOOL_MEMORY=4g
TOOL_PIDS_LIMIT=256
OFFICE_CPUS=2.0
OFFICE_MEMORY=4g
OFFICE_PIDS_LIMIT=256
MIN_FREE_DISK_GB=20
MIN_MEMORY_GB=8
POSTGRES_DB=offline_ai
POSTGRES_USER=offline_ai
POSTGRES_PASSWORD=CHANGE_ME
WEBUI_SECRET_KEY=CHANGE_ME
ADMIN_EMAIL=admin@offline.local
ADMIN_PASSWORD=CHANGE_ME
AGENT_SHARED_SECRET=CHANGE_ME
EMBEDDING_MODEL_PATH=/models/embedding
TZ=Asia/Shanghai
