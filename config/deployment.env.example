# Copy this file to config/deployment.env, edit it, then run: sudo ./deploy.sh
# Command-line options override values in this file.

# Web listener. If the preferred port is occupied, next tries higher ports;
# fail stops immediately without changing the port.
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8088
WEB_PORT_CONFLICT_POLICY=next

# Persistent data. Use a dedicated absolute directory with at least two parts.
DATA_ROOT=/TRS/lxAI

# OpenAI-compatible model. /chat/completions is accepted and normalized to /v1.
MODEL_BASE_URL=http://127.0.0.1:6215/v1/chat/completions
MODEL_NAME=TT3.6-27B-0623
MODEL_API_KEY=
MODEL_AUTO_DETECT=false

# Locale and initial administrator. Leave ADMIN_PASSWORD empty to generate one.
TZ=Asia/Shanghai
ADMIN_EMAIL=admin@offline.local
ADMIN_PASSWORD=

# Agent and tool behavior.
AGENT_MAX_STEPS=10
TOOL_TIMEOUT=120
SAFE_MODE=true
ALLOW_DANGEROUS_TOOLS=false
DB_WRITE_ENABLED=false
HTTP_ALLOW_PRIVATE_ONLY=true

# Container resource limits. Memory accepts Docker units such as 2g or 4096m.
AGENT_CPUS=2.0
AGENT_MEMORY=4g
AGENT_PIDS_LIMIT=256
TOOL_CPUS=2.0
TOOL_MEMORY=4g
TOOL_PIDS_LIMIT=256
OFFICE_CPUS=2.0
OFFICE_MEMORY=4g
OFFICE_PIDS_LIMIT=256

# Host preflight thresholds.
MIN_FREE_DISK_GB=20
MIN_MEMORY_GB=8

# Advanced database names. Leave passwords/secrets unset to generate them.
POSTGRES_DB=offline_ai
POSTGRES_USER=offline_ai
POSTGRES_PASSWORD=
WEBUI_SECRET_KEY=
AGENT_SHARED_SECRET=
EMBEDDING_MODEL_PATH=/models/embedding
