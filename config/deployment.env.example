# 将本文件复制为 config/deployment.env，按需修改后运行：sudo ./deploy.sh
# 命令行参数的优先级高于本配置文件中的值。

# Web 访问地址和端口。
# WEB_BIND_ADDRESS=0.0.0.0 表示监听服务器所有 IPv4 地址。
# 端口冲突策略：next 自动尝试后续端口；fail 立即停止部署。
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=8088
WEB_PORT_CONFLICT_POLICY=next

# 平台持久化数据目录。必须使用至少包含两级路径的专用绝对目录。
DATA_ROOT=/TRS/lxAI

# Docker 离线安装设置。
# true：缺少 Docker Engine 或 Compose 时，使用离线包内经过校验的安装文件自动安装。
# DOCKER_DATA_ROOT 仅在本平台首次安装 Docker Engine 时生效，不修改已有 Docker 的数据目录。
DOCKER_AUTO_INSTALL=true
DOCKER_DATA_ROOT=/TRS/lxAI/docker-engine

# 主机工具安装目录。服务器缺少 jq 时，会从离线包校验并安装到此目录。
HOST_TOOLS_INSTALL_DIR=/usr/local/bin

# OpenAI 兼容模型配置。
# MODEL_BASE_URL 可以填写 /v1 或完整的 /chat/completions 地址，部署时会自动规范为 /v1。
# MODEL_API_KEY 在模型接口无需鉴权时保持为空。
# MODEL_AUTO_DETECT=true 时才会只读探测本机可用模型；默认使用下方显式配置。
MODEL_BASE_URL=http://127.0.0.1:6215/v1/chat/completions
MODEL_NAME=TT3.6-27B-0623
MODEL_API_KEY=
MODEL_AUTO_DETECT=false

# 时区和初始管理员账号。ADMIN_PASSWORD 留空时自动生成强随机密码。
TZ=Asia/Shanghai
ADMIN_EMAIL=admin@offline.local
ADMIN_PASSWORD=

# Agent 与工具执行策略。
# SAFE_MODE=true 开启安全模式；ALLOW_DANGEROUS_TOOLS=true 才允许高风险工具。
# DB_WRITE_ENABLED=true 才允许数据库写操作。
# HTTP_ALLOW_PRIVATE_ONLY=true 时，HTTP 工具仅能访问内网或本机地址。
AGENT_MAX_STEPS=10
TOOL_TIMEOUT=120
SAFE_MODE=true
ALLOW_DANGEROUS_TOOLS=false
DB_WRITE_ENABLED=false
HTTP_ALLOW_PRIVATE_ONLY=true

# 容器资源限制。CPU 为核数；内存支持 Docker 单位，例如 2g 或 4096m；PIDS 为进程数上限。
AGENT_CPUS=2.0
AGENT_MEMORY=4g
AGENT_PIDS_LIMIT=256
TOOL_CPUS=2.0
TOOL_MEMORY=4g
TOOL_PIDS_LIMIT=256
OFFICE_CPUS=2.0
OFFICE_MEMORY=4g
OFFICE_PIDS_LIMIT=256

# 主机部署前检查阈值。磁盘和内存单位均为 GiB。
MIN_FREE_DISK_GB=20
MIN_MEMORY_GB=8

# 高级配置：数据库名称、账号、密钥与模型挂载路径。
# 密码和密钥留空时自动生成；通常无需手工填写。
POSTGRES_DB=offline_ai
POSTGRES_USER=offline_ai
POSTGRES_PASSWORD=
WEBUI_SECRET_KEY=
AGENT_SHARED_SECRET=
EMBEDDING_MODEL_PATH=/models/embedding
